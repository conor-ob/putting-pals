{
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "**",
      "!src/uniwind-types.d.ts",
      "!workbox-config.js",
      "!src/components/primitives",
      "!src/components/ui"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noDuplicateCustomProperties": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["public/index.html"],
      "linter": {
        "rules": {
          "a11y": {
            "useValidLang": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
